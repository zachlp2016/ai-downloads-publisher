    def normalize_tree(self, root: Path) -> None:
        for directory, directories, files in os.walk(root):
            os.chmod(directory, 0o755)
            for name in directories:
                os.chmod(Path(directory) / name, 0o755)
            for name in files:
                os.chmod(Path(directory) / name, 0o644)

    def promote(
        self,
        product: dict[str, Any],
        commit: str,
        staging: Path,
        manifest: dict[str, Any],
        installer: bytes,
        readme: bytes,
    ) -> None:
        product_root = self.public_root / str(product["public_path"])
        releases = product_root / "releases"
        releases.mkdir(parents=True, mode=0o755, exist_ok=True)
        destination = releases / commit
        if destination.exists():
            expected = manifest["archive"]["sha256"]
            existing = destination / manifest["archive"]["filename"]
            if not existing.is_file() or sha256_file(existing) != expected:
                raise PublisherError(
                    f"immutable release directory already exists with different content: {destination}"
                )
        else:
            hidden = releases / f".staging-{commit}-{os.getpid()}"
            if hidden.exists():
                raise PublisherError(f"unexpected publication staging path exists: {hidden}")
            shutil.copytree(staging, hidden, symlinks=True)
            self.normalize_tree(hidden)
            os.replace(hidden, destination)
            directory_fd = os.open(releases, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(directory_fd)
            finally:
                os.close(directory_fd)
        atomic_write(product_root / "install.sh", installer, 0o755)
        atomic_write(product_root / "README.txt", readme, 0o644)
        # The manifest is the public pointer and is deliberately switched last.
        write_json(product_root / "manifest.json", manifest, 0o644)

    def sync_one(
        self,
        name: str,
        *,
        retry_failed: bool = False,
        dry_run: bool = False,
    ) -> dict[str, Any]:
        if name not in self.products:
            raise PublisherError(f"unknown product: {name}")
        product = self.products[name]
        remote = self.remote_sha(product)
        published = self.published_sha(product)
        if remote == published:
            self.clear_failure(name)
            return {
                "product": name,
                "status": "current",
                "commit": remote,
            }
        if not retry_failed and remote == self.failed_sha(name):
            failure = load_json(self.failed_path(name))
            return {
                "product": name,
                "status": "qualification_blocked_cached",
                "commit": remote,
                "reason": failure.get("reason"),
            }

        checkout: Path | None = None
        staging: Path | None = None
        try:
            checkout = self.make_checkout(name, product, remote)
            tracked = self.tracked_files(checkout)
            self.credential_scan(checkout, tracked)
            product_type = str(product["product"])
            mode = str(product["qualification_mode"])
            if product_type == "terminal" and mode == "publisher_native":
                self.provenance_gate(checkout)
                validation = self.qualify_terminal_native(name, checkout, product)
            elif product_type == "terminal" and mode == "trusted_candidate":
                validation = self.qualify_terminal_candidate(
                    name, checkout, product, remote
                )
            elif product_type == "node-adapters" and mode == "publisher_native":
                validation = self.qualify_node_native(checkout, product)
            elif product_type == "node-adapters" and mode == "trusted_candidate":
                validation = self.qualify_node_candidate(
                    name, checkout, product, remote
                )
            else:
                raise PublisherError(
                    f"no qualification implementation for {product_type}/{mode}"
                )

            staging = Path(
                tempfile.mkdtemp(
                    prefix=f"{name}-{remote[:12]}-", dir=self.state_root / "staging"
                )
            )
            if os.geteuid() == 0:
                os.chown(staging, self.user_record.pw_uid, self.user_record.pw_gid)
            archive = self.make_archive(checkout, product, remote, staging)
            published_at = utc_now()
            if product_type == "terminal":
                receipt, manifest, readme = self.terminal_documents(
                    product,
                    remote,
                    archive,
                    len(tracked),
                    validation,
                    staging,
                    published_at,
                )
            else:
                receipt, manifest, readme = self.node_documents(
                    product,
                    remote,
                    archive,
                    len(tracked),
                    validation,
                    published_at,
                )
            write_json(staging / "release-receipt.json", receipt)
            sums = [f"{archive['sha256']}  {archive['filename']}"]
            if product_type == "terminal":
                for relative in (
                    validation["profile_relative_path"],
                    validation["lock_relative_path"],
                    validation.get("aider_lock_relative_path"),
                ):
                    if isinstance(relative, str):
                        sums.append(
                            f"{sha256_file(staging / relative)}  {relative}"
                        )
            atomic_write(
                staging / "SHA256SUMS",
                ("\n".join(sums) + "\n").encode("utf-8"),
            )
            installer = self.installer_for(
                self.installer_template_path(product),
                remote,
                archive["sha256"],
                base_url=f"https://downloads.techoverfl.com/{product['public_path']}",
                portable_checksum=bool(product.get("portable_checksum")),
            )
            if dry_run:
                return {
                    "product": name,
                    "status": "qualified_dry_run",
                    "published_commit": published,
                    "commit": remote,
                    "archive_sha256": archive["sha256"],
                }
            self.promote(product, remote, staging, manifest, installer, readme)
            self.clear_failure(name)
            return {
                "product": name,
                "status": "published",
                "previous_commit": published,
                "commit": remote,
                "archive_sha256": archive["sha256"],
            }
        except QualificationError as exc:
            if not dry_run:
                self.record_failure(name, remote, str(exc))
            return {
                "product": name,
                "status": (
                    "qualification_blocked_dry_run"
                    if dry_run
                    else "qualification_blocked"
                ),
                "commit": remote,
                "published_commit": published,
                "reason": bounded_output(str(exc), 4000),
            }
        finally:
            if checkout is not None:
                shutil.rmtree(checkout, ignore_errors=True)
            if staging is not None:
                shutil.rmtree(staging, ignore_errors=True)

    def sync(
        self,
        selected: list[str],
        *,
        retry_failed: bool = False,
        dry_run: bool = False,
    ) -> list[dict[str, Any]]:
        self.validate_environment(require_root=True)
        lock_path = self.state_root / "locks" / "publisher.lock"
        with lock_path.open("a+b") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError as exc:
                raise PublisherError("another publisher run is already active") from exc
            return [
                self.sync_one(
                    name,
                    retry_failed=retry_failed,
                    dry_run=dry_run,
                )
                for name in selected
            ]

    def status(self, selected: list[str], *, include_remote: bool) -> list[dict[str, Any]]:
        self.validate_environment(require_root=False)
        results = []
        for name in selected:
            if name not in self.products:
                raise PublisherError(f"unknown product: {name}")
            item: dict[str, Any] = {
                "product": name,
                "published_commit": self.published_sha(self.products[name]),
                "blocked_commit": self.failed_sha(name),
            }
            if include_remote:
                item["github_commit"] = self.remote_sha(self.products[name])
            results.append(item)
        return results


def parse_pytest_counts(output: str) -> dict[str, int]:
    passed = re.findall(r"(\d+) passed", output)
    failed = re.findall(r"(\d+) failed", output)
    skipped = re.findall(r"(\d+) skipped", output)
    if not passed:
        raise QualificationError("pytest completed without a parseable passed-test count")
    return {
        "passed": int(passed[-1]),
        "failed": int(failed[-1]) if failed else 0,
        "skipped": int(skipped[-1]) if skipped else 0,
    }


def parse_node_counts(output: str) -> dict[str, int]:
    def value(label: str) -> int:
        matches = re.findall(rf"(?m)^# {label} (\d+)\s*$", output)
        if not matches:
            raise QualificationError(f"Node TAP output has no {label} count")
        return int(matches[-1])

    return {"passed": value("pass"), "failed": value("fail"), "skipped": value("skipped")}


def parse_unittest_count(output: str) -> int:
    matches = re.findall(r"Ran (\d+) tests?", output)
    if not matches:
        raise QualificationError("unittest output has no test count")
    return int(matches[-1])


def choose_products(publisher: Publisher, requested: list[str] | None) -> list[str]:
    if not requested or "all" in requested:
        return list(publisher.products)
    unknown = set(requested) - set(publisher.products)
    if unknown:
        raise PublisherError("unknown products: " + ", ".join(sorted(unknown)))
    return requested


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", default=DEFAULT_CONFIG)
    subparsers = parser.add_subparsers(dest="command", required=True)
    sync_parser = subparsers.add_parser("sync", help="qualify and publish changed refs")
    sync_parser.add_argument(
        "--product", action="append"
    )
    sync_parser.add_argument(
        "--retry-failed",
        action="store_true",
        help="retry a commit already recorded as qualification-blocked",
    )
    sync_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="qualify and build without promoting public files",
    )
    status_parser = subparsers.add_parser("status", help="show publication state")
    status_parser.add_argument(
        "--product", action="append"
    )
    status_parser.add_argument(
        "--remote", action="store_true", help="also query GitHub over SSH"
    )
    arguments = parser.parse_args(argv)
    try:
        publisher = Publisher(Path(arguments.config))
        selected = choose_products(publisher, arguments.product)
        if arguments.command == "sync":
            result = publisher.sync(
                selected,
                retry_failed=arguments.retry_failed,
                dry_run=arguments.dry_run,
            )
        else:
            result = publisher.status(selected, include_remote=arguments.remote)
        print(json.dumps(result, indent=2))
        return 0
    except (PublisherError, subprocess.TimeoutExpired) as exc:
        print(f"publisher infrastructure error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
